# --- Database ---
POSTGRES_DB=kartylicious
POSTGRES_USER=kartylicious
POSTGRES_PASSWORD=change-me

# --- Auth (JWT) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-not-a-secret-change-me-0123456789
JWT_EXPIRATION_MINUTES=60

# --- Admin bootstrap ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@kartylicious.test
ADMIN_PASSWORD=change-me-admin-pass

# --- Payment sandbox (Stripe test mode) ---
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# --- Telemetry (MQTT broker) ---
MQTT_BROKER_URL=tcp://mqtt:1883
MQTT_TOPIC_PREFIX=kartylicious/karts